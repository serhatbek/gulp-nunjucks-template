{
  "name": "gulp-nunjucks-template",
  "version": "1.0.0",
  "main": "gulpfile.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development gulp --gulpfile gulpfile.js devTasks",
    "build": "cross-env NODE_ENV=production gulp --gulpfile gulpfile.js buildTasks",
    "scssLint": "stylelint \"src/scss/**/*.scss\" \"!src/scss/vendors/**/*.scss\" --fix --allow-empty-input",
    "jsLint": "eslint \"src/js/**/*.js\"",
    "icons": "svgtofont --sources ./src/icons --output ./dist/assets/fonts/icons --config ./svgtofont.config.js",
    "docs": "docsify serve ./docs"
  },
  "keywords": [],
  "author": "Serhat Bek (https://github.com/serhatbek)",
  "license": "MIT",
  "description": "A powerful, modern frontend build workflow using **Gulp 5**, **Nunjucks**, and **SCSS**. Designed for long-term reliability and simple maintenance.",
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@eslint/js": "^9.26.0",
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.4",
    "chalk": "^4.1.2",
    "cross-env": "^7.0.3",
    "del": "^8.0.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "fancy-log": "^2.0.0",
    "globals": "^16.1.0",
    "gulp": "^5.0.0",
    "gulp-babel": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-consolidate": "^0.2.0",
    "gulp-data": "^1.3.1",
    "gulp-htmlmin": "^5.0.1",
    "gulp-if": "^3.0.0",
    "gulp-nunjucks-render": "^2.2.3",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-run": "^1.7.1",
    "gulp-sass": "^6.0.1",
    "gulp-size": "^5.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-terser": "^2.1.0",
    "gulp-uglify": "^3.0.2",
    "gulp-webp": "^5.0.0",
    "path": "^0.12.7",
    "sass": "^1.87.0",
    "stylelint": "^16.19.1",
    "stylelint-config-standard-scss": "^15.0.0",
    "stylelint-scss": "^6.12.0",
    "svgtofont": "^6.3.2"
  },
  "dependencies": {
    "docsify-darklight-theme": "^3.2.0",
    "swiper": "^11.2.6"
  }
}
